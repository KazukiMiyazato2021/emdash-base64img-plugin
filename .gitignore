# 依存パッケージ
node_modules/

# ビルド出力
dist/
.astro/

# playground のデータベース(SQLite)
*.db
*.db-*
*.sqlite*

# wrangler のローカル状態(D1 など)
.wrangler/

# Playwright の出力
test-results/
playwright-report/

# E2E の global setup が作るもの(ログインの状態・API で上げる画像)
e2e/.cache/

# worktree の置き場
.claude/worktrees/

# スパイクのコードはコミットしない(使い捨て)。説明の README だけを残す。
spikes/*
!spikes/README.md
