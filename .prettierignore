# prettier はコードと設定ファイルだけを対象にする。
# .gitignore に書いたもの(node_modules・ビルド出力・spikes/ のコードなど)は、prettier 3 が既定で読むので除外される。

# 生成物
package-lock.json

# リポジトリの外から持ち込んだもの・worktree
references/
.claude/

# playground のビルド出力
playground/dist/
playground/.astro/

# スパイク(使い捨て)
spikes/

# Markdown のノート(Obsidian 形式なので整形しない)
plans/
tasks/
docs/
*.md

# Obsidian の設定(利用者の手元にだけある。.git/info/exclude で除外していて、prettier はそれを読まない)
.obsidian/

# playground で EmDash と Astro が生成するもの(playground/.gitignore で git から外している。prettier はそれを読まない)
# emdash-env.d.ts は開発サーバーの起動時に生成され、末尾に改行が無い
playground/emdash-env.d.ts
playground/.emdash/
