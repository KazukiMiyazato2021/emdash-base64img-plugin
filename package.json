{
	"name": "emdash-plugin-base64-image",
	"version": "0.0.0",
	"private": true,
	"description": "EmDash native plugin that stores images as base64 WebP data URLs without object storage",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.tsx",
		"./astro": "./src/astro.ts"
	},
	"files": [
		"src"
	],
	"workspaces": [
		"playground"
	],
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.consumer-loose.json && tsc --noEmit -p tsconfig.consumer-strict.json",
		"build": "npm run typecheck && npm run build --workspaces --if-present",
		"lint": "oxlint --deny-warnings && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"verify": "npm run build && npm run lint && npm test"
	},
	"dependencies": {
		"zod": "^4.5.4"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "2.6.0",
		"@emdash-cms/admin": "^0.39.0",
		"emdash": "^0.39.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@astrojs/react": "^6.0.5",
		"@cloudflare/kumo": "2.6.0",
		"@emdash-cms/admin": "0.39.1",
		"@playwright/test": "1.63.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.2",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"astro": "^7.3.2",
		"emdash": "0.39.1",
		"jsdom": "^30.1.0",
		"oxlint": "^1.83.0",
		"prettier": "^3.9.8",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
